@import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
:root{font-family:'DM Sans','Apple SD Gothic Neo',sans-serif;color:#282521;background:#f7f5f0;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}button,input,textarea{font:inherit}.nav{height:76px;max-width:1220px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between}.brand{color:#292622;text-decoration:none;font-size:22px;letter-spacing:-1.4px;font-weight:700;display:flex;gap:10px;align-items:center}.brand>span>span{color:#e96d4c}.logo-symbol{width:29px;height:29px;display:grid;place-items:center;position:relative;background:#e96d4c;border-radius:50%;overflow:hidden}.logo-symbol i{position:absolute;display:block;background:#fff0df;border-radius:50%}.logo-symbol i:first-child{width:13px;height:13px;left:4px;top:5px}.logo-symbol i:nth-child(2){width:9px;height:9px;right:4px;bottom:4px;background:#fff}.logo-symbol i:last-child{width:4px;height:4px;right:6px;top:5px;background:#542e27}.nav nav{display:flex;gap:30px;margin-left:80px}.nav nav a{color:#716d65;text-decoration:none;font-size:14px}.account-button{color:#fff;background:#292622;border:0;border-radius:99px;padding:10px 15px 10px 18px;font-size:13px;display:flex;align-items:center;gap:9px;cursor:pointer}.account-button svg,.hero-cta svg,.generate-button svg{width:16px;fill:none;stroke:currentColor;stroke-width:1.8}.hero{max-width:1220px;margin:0 auto 88px;min-height:480px;padding:83px 90px;color:#fff;background:#2b2925;border-radius:0 0 38px 38px;position:relative;overflow:hidden}.hero>*:not(.hero-art){position:relative;z-index:1}.hero-art{position:absolute;inset:0;overflow:hidden}.orb{position:absolute;border-radius:50%;display:block}.orb-one{width:570px;height:570px;right:-105px;top:-230px;background:radial-gradient(circle at 35% 40%,#f49b72 0 1%,#c36042 25%,#6d3c2f 53%,transparent 69%)}.orb-two{width:390px;height:390px;right:80px;bottom:-300px;border:1px solid #805143}.orb-three{width:15px;height:15px;right:230px;top:115px;background:#f8c094}.hero-star{position:absolute;right:145px;bottom:72px;color:#f8b083;font-size:34px}.kicker{color:#e98b6c;font:11px 'DM Mono',monospace;letter-spacing:1.6px;margin:0 0 18px;display:flex;align-items:center;gap:8px}.kicker svg{width:14px;fill:currentColor}.hero h1{font-size:59px;letter-spacing:-4px;line-height:1.07;margin:0;font-weight:600}.hero h1 em{font-family:'Playfair Display',serif;color:#f29772;font-weight:600}.hero-copy{max-width:445px;color:#cbc5bc;line-height:1.7;font-size:15px;margin:22px 0 29px}.hero-cta{color:#2e2925;background:#f8ead9;border-radius:99px;padding:13px 18px 13px 20px;text-decoration:none;display:inline-flex;align-items:center;gap:16px;font-size:13px;font-weight:700}.creator,.result-section{max-width:1050px;margin:auto;padding-bottom:92px}.section-intro,.result-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.section-intro h2,.result-heading h2{font-size:29px;letter-spacing:-1.7px;margin:0}.section-intro>div>p:last-child,.result-heading>div>p:last-child{color:#858079;font-size:14px;margin:9px 0 0;line-height:1.6}.section-intro>span{color:#b7b1a7;font:12px 'DM Mono',monospace}.section-intro>span i{display:inline-block;width:37px;height:1px;background:#cfc9bd;vertical-align:middle;margin:0 9px}.creator-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:25px}.input-card,.preview-card{background:#fff;border:1px solid #e9e5dd;border-radius:16px}.input-card{padding:34px}.input-field{margin-bottom:24px}.input-field label{display:block;font-weight:700;font-size:13px;margin-bottom:10px}.input-field label b{color:#e8694b}.input-field input,.input-field textarea,.auth-modal input{width:100%;border:1px solid #ded9d0;border-radius:8px;padding:13px 14px;background:#fff;outline:0;color:#2d2a27;font-size:14px}.input-field input:focus,.input-field textarea:focus,.auth-modal input:focus{border-color:#e77455;box-shadow:0 0 0 3px #fbeee9}.input-field textarea{height:98px;resize:vertical;line-height:1.55}.category-list{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.category-list button,.goal-list button{border:1px solid #e3ded5;background:#fff;border-radius:8px;cursor:pointer;color:#69645d;font-size:11px}.category-list button{height:61px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3px}.category-list i{font-style:normal;font-size:16px;color:#9b9488}.category-list .is-active,.goal-list .is-active{color:#d9593d;border-color:#e66c4e;background:#fff7f4;font-weight:700}.category-list .is-active i{color:#e56547}.goal-list{display:flex;flex-wrap:wrap;gap:7px}.goal-list button{padding:9px 12px}details{border-top:1px solid #eeebe5;padding-top:18px}summary{font-size:13px;cursor:pointer;list-style:none;color:#625e58;font-weight:600;display:flex;justify-content:space-between}summary::-webkit-details-marker{display:none}summary span{font-size:17px;font-weight:400}.details-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding-top:21px}.details-grid .input-field{margin-bottom:0}.generate-button{width:100%;height:52px;border:0;border-radius:9px;background:#e6694b;color:#fff;box-shadow:0 10px 22px #e5654736;font-weight:700;display:flex;justify-content:center;align-items:center;gap:10px;margin-top:26px;cursor:pointer}.generate-button svg:first-child{fill:currentColor;stroke:none}.generate-button:disabled{opacity:.68;cursor:wait}.notice{text-align:center;color:#c2573f;font-size:12px;margin:12px 0 0}.preview-card{background:#2b2925;color:#fbf7ef;min-height:580px;padding:34px 30px;position:relative;overflow:hidden}.preview-card:after{content:'';position:absolute;width:390px;height:390px;border-radius:50%;border:1px solid #565049;bottom:-265px;left:-165px}.preview-label{font:10px 'DM Mono',monospace;letter-spacing:1.5px;color:#c8c0b3}.preview-number{font:68px 'Playfair Display',serif;color:#e77e5d;margin:48px 0 14px}.preview-card h3{font-size:25px;letter-spacing:-1.4px;line-height:1.28;margin:0}.preview-card>p{font-size:13px;line-height:1.7;color:#bcb5ab;margin:15px 0 30px}.preview-card ul{list-style:none;padding:0;margin:0;position:relative;z-index:1}.preview-card li{border-top:1px solid #494640;padding:12px 0;font-size:12px;color:#ddd6cd}.preview-card li b{font:10px 'DM Mono',monospace;color:#eb8b6a;margin-right:12px}.result-section{padding-bottom:105px}.result-empty{background:#eeece5;border-radius:18px;min-height:300px;display:grid;place-content:center;text-align:center;color:#777168}.result-empty span{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#e76e50;color:#fff;margin:auto}.result-empty span svg{width:19px;fill:currentColor}.result-empty h2{font-size:26px;letter-spacing:-1.4px;line-height:1.3;margin:18px 0 7px;color:#34312d}.result-empty p{font-size:13px;margin:0}.complete{font-size:11px;color:#4a7c53;background:#e8f1e6;border-radius:99px;padding:6px 11px}.plan-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px}.plan-overview article,.full-script{background:#fff;border:1px solid #e9e5dd;border-radius:12px;padding:18px}.plan-overview span,.full-script>span{display:block;color:#dc6d4e;font:10px 'DM Mono',monospace;letter-spacing:1px;margin-bottom:8px}.plan-overview strong{font-size:13px;line-height:1.5}.timeline{display:grid;grid-template-columns:255px 1fr;background:#fff;border:1px solid #e9e5dd;border-radius:15px;overflow:hidden}.scene-nav{background:#f2f0eb;padding:10px}.scene-nav button{display:grid;grid-template-columns:31px 1fr auto;gap:8px;align-items:center;width:100%;text-align:left;border:0;background:transparent;border-radius:8px;padding:13px 10px;cursor:pointer;color:#777168}.scene-nav button.active{background:#fff;color:#302c28;box-shadow:0 2px 10px #342b2210}.scene-nav span{font:10px 'DM Mono',monospace;color:#d66c50}.scene-nav b{font-size:12px}.scene-nav small{font-size:10px;color:#999288}.scene-detail{padding:30px}.scene-meta{display:flex;justify-content:space-between;color:#db704f;font:10px 'DM Mono',monospace;letter-spacing:.5px}.scene-detail h3{font-size:24px;letter-spacing:-1.2px;margin:18px 0 9px}.scene-detail>p{color:#69645d;font-size:14px;line-height:1.7}.direction,.script{margin-top:21px;border-radius:8px;padding:14px 16px}.direction{background:#f7f4ee}.script{background:#fff6f2;border-left:3px solid #e56a4b}.direction b,.script b{font-size:11px;color:#d85e41}.direction p,.script p{font-size:13px;line-height:1.65;margin:7px 0 0}.full-script{margin-top:20px}.full-script h3{margin:0 0 10px;font-size:21px;letter-spacing:-1px}.full-script p{margin:0;white-space:pre-wrap;line-height:1.8;font-size:14px;color:#5f5a53}.modal-backdrop{position:fixed;inset:0;background:#29262299;z-index:10;display:grid;place-items:center;padding:18px}.auth-modal{position:relative;background:#fff;border-radius:16px;width:min(410px,100%);padding:34px}.auth-modal>.logo-symbol{margin-bottom:19px}.auth-modal h2{font-size:25px;letter-spacing:-1.3px;margin:0 0 8px}.auth-modal>p{color:#807a72;font-size:13px;line-height:1.5;margin:0 0 22px}.auth-modal label{display:block;font-size:12px;font-weight:700;margin:13px 0}.auth-modal input{margin-top:7px}.close{position:absolute;right:15px;top:10px;background:none;border:0;font-size:27px;color:#837d75;cursor:pointer}.auth-submit{height:47px;width:100%;background:#e6694b;color:#fff;border:0;border-radius:8px;font-weight:700;margin-top:8px;cursor:pointer}.mode-switch{display:block;background:none;border:0;color:#956c5e;font-size:12px;margin:16px auto 0;cursor:pointer}footer{max-width:1220px;margin:auto;border-top:1px solid #dedad1;padding:28px;color:#999287;display:flex;justify-content:space-between;font-size:12px}@media(max-width:760px){.nav{height:66px;padding:0 20px}.nav nav{display:none}.hero{border-radius:0;min-height:475px;padding:74px 28px;margin-bottom:57px}.hero h1{font-size:46px;letter-spacing:-3px}.hero-copy{max-width:325px}.orb-one{right:-300px}.hero-star{right:38px;bottom:40px}.creator,.result-section{padding:0 20px 62px}.section-intro,.result-heading{display:block}.section-intro>span{display:none}.section-intro h2,.result-heading h2{font-size:26px}.creator-grid{grid-template-columns:1fr}.input-card{padding:25px 20px}.category-list{grid-template-columns:repeat(3,1fr)}.details-grid{grid-template-columns:1fr}.preview-card{min-height:410px}.preview-number{margin:27px 0 10px}.plan-overview,.timeline{grid-template-columns:1fr}.scene-nav{display:flex;overflow:auto;padding:8px}.scene-nav button{min-width:132px;grid-template-columns:24px 1fr}.scene-nav button small{display:none}.scene-detail{padding:24px 20px}.scene-meta{gap:8px}.scene-meta span:last-child{white-space:nowrap}footer{padding:25px 20px}.brand{font-size:20px}}
